# Creativo memakai mock API lokal (server/, jalankan: npm run server).
# Biasanya tidak perlu diisi: aplikasi otomatis memakai IP laptop yang menjalankan `expo start`, port 4000.
# Isi kalau server ada di alamat lain, misalnya saat memakai `expo start --tunnel` atau PORT lain:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:4000

# Supabase ditunda dulu. Kunci lama boleh tetap ada di .env, tapi tidak dipakai aplikasi.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
